# Testovací logy z karty patří do větve arena/01a0aad9-test, ne sem.
# (Dřív se sem omylem dostaly přes `git add -A` a pak pletly další session,
#  protože vypadaly jako aktuální data.)
*.log
# Archiv dozpeleho mereni zustava v repu zamerne (vyjimka z *.log):
!archiv/logy/*.log

# Meziprodukty CI buildu (build-switch.sh používá .ciwork, výstup jde do out/)
.ciwork/
out/
dist/

# Python bytecode z lokálního ladění patch skriptů
__pycache__/
*.pyc
